# Private account-registry spreadsheet ID from the Google Sheets URL.
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Base64-encoded Google service-account JSON. Keep this secret on the server.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=replace-with-base64-encoded-service-account-json

# Private admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-private-numeric-password

# At least 32 bytes. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

PORT=4173
# NODE_ENV=production
