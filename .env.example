# Copy this file to .env and fill in values from your Supabase project.
# Never commit .env or expose the service-role key to frontend code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Configure a strong private admin password (6-12 digits only in this preview).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-numeric-password

PORT=4173
# NODE_ENV=production
