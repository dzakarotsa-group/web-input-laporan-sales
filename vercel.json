{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {}
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__lead_desk_path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__lead_desk_path=/api/:path*"
    }
  ]
}
